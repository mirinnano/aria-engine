  await advance;
  narrate "「うーん....たくさんボタンが多すぎてわかんないよ」";
  await advance;
  narrate "「じゃあとりあえず牛丼にしとけ」";
  await advance;
  narrate "「わかった」";
  await advance;
  narrate "ミオは牛めしの並盛を押した。";
  await advance;
  narrate "俺も同じものを押す。";
  await advance;
