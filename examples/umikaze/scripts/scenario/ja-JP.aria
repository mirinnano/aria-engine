    "序章" => novel_chapter_00;
    "DAY 1" => novel_chapter_01;
    "DAY 2" => novel_chapter_02;
    "DAY 3" => novel_chapter_03;
    "DAY 4" => novel_chapter_04;
    "DAY 5" => novel_chapter_05;
    "DAY 6" => novel_chapter_06;
    "DAY 7" => novel_chapter_07;
    "DAY 8" => novel_chapter_08;
    "DAY 9" => novel_chapter_09;
    "DAY 10" => novel_chapter_10;
    "DAY 14" => novel_chapter_11;
    "後日談" => novel_chapter_12;
  }
}

// Source: 00_init.md
scene novel_chapter_00 {
  locale "ja-JP";
  persistent flag "canonical_chapter_00_seen" = true;
  unlock chapter "canonical_chapter_00" progress 1;
  screen dialogue;
  background asset("#102b38") with fade(260ms);
  narrate "病室の窓から見える景色は、毎日少しずつ変わっていく。";
  await advance;
  narrate "けれど、私の一日はほとんど変わらない。";
  await advance;
  narrate "小学校の時に初めて倒れて入院して以来、";
  await advance;
  narrate "私の世界は、この一部屋に収まるほどのちんけなものになってしまった。";
  await advance;
  narrate "毎日窓から景色を見て、それ以外は寝る生活。";
  await advance;
  narrate "テレビなんてとっくに飽きちゃって。";
  await advance;
  narrate "たまに部屋が静かすぎて、テレビをつけるぐらいのこと。";
  await advance;
  narrate "お見舞いなんて誰も来ない。";
  await advance;
  narrate "来たって、お母さんぐらいだし、友達ももう、他人みたいなものになってしまった。";
  await advance;
  narrate "今更友達になんて会えなくて、みんながなにかしてるのに、私は寝てるだけ。";
  await advance;
  narrate "病人って、これが普通なんだろうけど。";
  await advance;
  narrate "「だって、人が死ぬとこなんて...わざわざ見る人なんていないもんね」";
  await advance;
  narrate "私はいつものように、窓のむこうを見る。";
  await advance;
  narrate "「きれいな桜...」";
  await advance;
  narrate "桜は満開の季節。けれど、近くで見れるわけでもない。";
  await advance;
  narrate "独りで見に行きたいのに、毎回看護師さんがついてくる。";
  await advance;
  narrate "人に見られてたら、なんか落ち着かなくて。";
  await advance;
  narrate "もう死ぬんだから、ほおっておいてくれてもいいのにね...";
  await advance;
  narrate "窓のむこうで、桜が舞い散る。";
  await advance;
  narrate "そして数日、また数日と経ち、桜が枯れる頃。";
  await advance;
  narrate "お母さんがお見舞いに来た。";
  await advance;
  narrate "「...来てくれたんだ」";
  await advance;
  narrate "そこから、他愛ない話を30分ぐらいした。";
  await advance;
  narrate "「なんか、看護師さんに言われたんだけれど...」";
  await advance;
  narrate "「お家、一旦帰っていいってよ」";
  await advance;
  narrate "お母さんが、私の目を見て話す。";
  await advance;
  narrate "「そっか」";
  await advance;
  narrate "それが何を意味するかってのは、私でもわかる。";
  await advance;
  narrate "「...お家、帰る？」";
  await advance;
  narrate "「さあ...ちょっと考えさせて」";
  await advance;
  narrate "結局のところ、家にいたって、ここにいたって、寝たきりなのは変わらない。";
  await advance;
  narrate "帰る意味...まあ、世話してくれたし、最後ぐらいは家で過ごしてもいいのかもな。";
  await advance;
  narrate "母親はまだ、私の目を見ている。";
  await advance;
  narrate "笑顔で、けれど泣きそうな顔で。";
  await advance;
  narrate "私はその目を見つめ返す。";
  await advance;
  narrate "「...帰ろう」";
  await advance;
  narrate "母親は、ハンカチで涙を拭いた...";
  await advance;
  narrate "親の車で、家にたどり着いた。";
  await advance;
  narrate "珍しく家全体が大掃除でもしたかのようにピカピカ。";
  await advance;
  narrate "私の部屋を覗く。";
  await advance;
  narrate "整理整頓された勉強机、ホテルみたいに整理されたベッド。";
  await advance;
  narrate "クローゼットの中は、子供の頃と全く変わっていなかった。";
  await advance;
  narrate "なんとなく、勉強机に向き合ったりしてみる。";
  await advance;
  narrate "いまさら、教科書なんて開く気になれなくて。";
  await advance;
  narrate "ベッドに横たわる。";
  await advance;
  narrate "天井を見た。";
  await advance;
  narrate "白い。";
  await advance;
  narrate "...";
  await advance;
  narrate "いつの間にか、寝ていた。";
  await advance;
  narrate "そして、いつの間にか、目を覚ましていた。";
  await advance;
  narrate "横を見ると、ラップに包まれたお粥が置かれてる。";
  await advance;
  narrate "まだほんのりと温かい。";
  await advance;
  narrate "ラップを取り、お粥をスプーンですくう。";
  await advance;
  narrate "味、うすいな...";
  await advance;
  narrate "昔食べさせてくれたお粥とは全く違って...";
  await advance;
  narrate "ちょっとずつ食べていると、お母さんがドアを開けて覗いていた。";
  await advance;
  narrate "目線を合わす。";
  await advance;
  narrate "お母さんはドアを閉め、去っていった。";
  await advance;
  narrate "お粥を食べる。";
  await advance;
  narrate "さっきより、塩気が強いって思うのは、なんでだろ...";
  await advance;
  narrate "...";
  await advance;
  narrate "桜は散り、幾度の雨が降る季節のこと。";
  await advance;
  narrate "じめじめした部屋で、私は今日も寝ていた。";
  await advance;
  narrate "私の部屋で、洗濯物が干されてる。";
  await advance;
  narrate "だから、じめじめするのか。";
  await advance;
  narrate "なんとなく立ち上がってみて、また勉強机に座ってみる。";
  await advance;
  narrate "教科書の隣に挟まってるノートを読んでみる。";
  await advance;
  narrate "英語のノートだった。";
  await advance;
  narrate "三単現について勉強してたみたい。";
  await advance;
  narrate "少し疲れて、布団に戻る。";
  await advance;
  narrate "「暇だなぁ」";
  await advance;
  narrate "...";
  await advance;
  narrate "外ではうるさく蝉が鳴いている。";
  await advance;
  narrate "クーラーから冷たい風が吹き、とても涼しい。";
  await advance;
  narrate "部屋の中は暗かった。";
  await advance;
  narrate "ずっと寝て、少し起きる生活。";
  await advance;
  narrate "今が何時なのかすらわからない。";
  await advance;
  narrate "カーテンがしまってる。";
  await advance;
  narrate "少し立とうとして、めんどくさいからやめた。";
  await advance;
  narrate "扉が開く。お母さんだ。";
  await advance;
  narrate "「...麦茶、持ってきたよ」";
  await advance;
  narrate "「ありがと」";
  await advance;
  narrate "お母さんが、私の横にトレーを置く。";
  await advance;
  narrate "そっか、昼なのか...";
  await advance;
  narrate "扉の向こうから、光が差し込む。";
  await advance;
  narrate "また、寝よう...";
  await advance;
  narrate "...";
  await advance;
  narrate "あんなにうるさかった蝉が消え、少し涼しくなった頃。";
  await advance;
  narrate "また、私は寝ていた。";
  await advance;
  narrate "パジャマは半袖から長袖へと変わった。";
  await advance;
  narrate "なんとなく、また勉強机へと向かう。";
  await advance;
  narrate "前に開いた英語のノートの空きページを開いてみた。";
  await advance;
  narrate "ノートはまだ半分も余っていた。";
  await advance;
  narrate "一人で外を見たい。";
  await advance;
  narrate "誰にも見張られずに歩きたい。";
  await advance;
  narrate "部屋から出て、家の書斎を漁る。";
  await advance;
  narrate "本棚には、古い時刻表があった。";
  await advance;
  narrate "なんとなく、それを読んでみた。";
  await advance;
  narrate "びっしりと並ぶ数字の羅列。";
  await advance;
  narrate "駅名とか、細かい数字が並ぶ本を部屋に持ち帰る。";
  await advance;
  narrate "ノートに書き写す。";
  await advance;
  narrate "わたしの家の最寄り駅から、ひたすら、知っている駅へとつなげてく。";
  await advance;
  narrate "数十分経って、お母さんが家に帰ってきた。";
  await advance;
  narrate "焦ってノートを閉じ、布団に入る。";
  await advance;
  narrate "「寝るかな...」";
  await advance;
  narrate "布団を被る。いつもより早く、寝れた気がした。";
  await advance;
  narrate "また、ノートを開く。";
  await advance;
  narrate "最初は知っている駅と知っている駅をつなぐ程度だったのが、";
  await advance;
  narrate "今は最適なルートを選べてる気がする。";
  await advance;
  narrate "お母さんがいない時間に、いろいろな本を見たおかげかな。";
  await advance;
  narrate "結局、桜木町まで歩いて、そっから横浜に行って、東海道線に乗ることにした。";
  await advance;
  narrate "なんか、最寄り駅だと知ってる人いるから。";
  await advance;
  narrate "嫌だなって。";
  await advance;
  narrate "「蝉が死んでる...」";
  await advance;
  narrate "秋の朝のこと。";
  await advance;
  narrate "私は、荷物を取りに学校に向かっていた。";
  await advance;
  narrate "英語のノートだけは、手に抱えて。";
  await advance;
  narrate "持っていくか迷ったけど、お母さんに見られるのが一番嫌だから。";
  await advance;
  narrate "行く前にも、何回も「送っていこうか？」って言われたけど、何回も嫌だって言ったら、渋々許してくれた。";
  await advance;
  narrate "帰りはお母さんが迎えに来るらしい。";
  await advance;
  narrate "昔に使った、裏道を使って学校に行く。";
  await advance;
  narrate "「疲れた...」";
  await advance;
  narrate "「こんなに坂、きつかったっけな」";
  await advance;
  narrate "まあ、それも病気のせいなんだろな。";
  await advance;
  narrate "帰りは下るだけ、それなら許せる...";
  await advance;
  narrate "坂を登って、トンネルを通って、私は学校にたどり着いた。";
  await advance;
  narrate "インターホンを押す。";
  await advance;
  narrate "「...」";
  await advance;
  narrate "何も話していないのに、ドアのロックが開く音がした。";
  await advance;
  narrate "また坂を登り、校舎につく。";
  await advance;
  narrate "職員専用の入口から入って、職員室に行く。";
  await advance;
  narrate "ノックをする。";
  await advance;
  narrate "ガラガラ、と音がして、担任の先生？がたくさんの配布物と、大事な書類を渡す。";
  await advance;
  narrate "「ロッカーに残ってる荷物も持っていって」";
  await advance;
  narrate "...これだけじゃないのか。";
  await advance;
  narrate "重いなぁ...";
  await advance;
  narrate "職員室を出て、階段を登る。わたしの教室は最上階だ。";
  await advance;
  narrate "手すりにつかまって息を整えながら、最上階へとたどり着く。";
  await advance;
  narrate "でも、その先にも階段は続いてた。";
  await advance;
  narrate "...最上階の先から、金属を何度も揺らす音がした。";
  await advance;
  narrate "ちょっと迷ったけれど、階段を登る。";
  await advance;
  narrate "そこには、人の影があった。";
  await advance;
  narrate "「誰だ」";
  await advance;
  narrate "俺は後ろを振り向くと、手提げを持った、少女が立っていた。";
  await advance;
  narrate "「...今って授業中だよね";
  await advance;
  narrate "ここで何してるの？」";
  await advance;
  narrate "「屋上、行こうとしてるんだ」";
  await advance;
  narrate "「開かないの？」";
  await advance;
  narrate "「鍵、かかってるみたい」";
  await advance;
  narrate "「...開けようと思わないの？」";
  await advance;
  narrate "「...思う」";
  await advance;
  narrate "少女は手提げを足元に置いた。";
  await advance;
  narrate "「じゃあ、手伝うよ」";
  await advance;
  narrate "「どうやって、やるのさ」";
  await advance;
  narrate "「...どうしたらいいんだろうね」";
  await advance;
  narrate "「押してみる？それとも引いてみる？」";
  await advance;
  narrate "「押してみよ」";
  await advance;
  narrate "２人で、体当たりをした。";
  await advance;
  narrate "重い金属音が、階段に反響する。";
  await advance;
  narrate "「開かない...」";
  await advance;
  narrate "二度目。";
  await advance;
  narrate "金属が裂けるような音がして、扉が急に外へ開いた。";
  await advance;
  narrate "支えを失い、俺たちはそのまま屋上へ転がり込んだ。";
  await advance;
  narrate "足元に、錆びたねじが跳ねた。";
  await advance;
  narrate "南京錠は、掛け金に付いたままだった。";
  await advance;
  narrate "「...開いた」";
  await advance;
  narrate "「壊れた、でしょ」";
  await advance;
  narrate "俺には優秀な兄がいる。";
  await advance;
  narrate "どこに出しても恥ずかしくないような、医者である両親の完璧な最高傑作。";
  await advance;
  narrate "それに比べて俺は、出来損ないでしかなかった。";
  await advance;
  narrate "深夜まで続く塾。";
  await advance;
  narrate "山のように積まれた課題と教材。";
  await advance;
  narrate "「お兄ちゃんはできたのに」「どうして君にはできないんだ」。";
  await advance;
  narrate "実家の勉強机に座るたび、ピアノ線に首を絞められているような息苦しさに襲われた。";
  await advance;
  narrate "9月18日　学校の保健室　昼休み";
  await advance;
  narrate "だから、俺が息の詰まる授業をサボって、保健室のベッドに逃げ込んだのは、ごく自然なことだった。";
  await advance;
  narrate "仮病を使って毛布を被り、昼休みのチャイムが鳴るのを待つ。";
  await advance;
  narrate "廊下が一気に騒がしくなる。";
  await advance;
  narrate "教室へ戻る気にはなれなかった。";
  await advance;
  narrate "いっそこのまま、目覚めなければいいのに。";
  await advance;
  narrate "そう思いながら目を閉じていると、隣のベッドのカーテンがシャッ、と開いた。";
  await advance;
  narrate "そこに立っていたのは、幽霊のように顔色の悪い少女だった。";
  await advance;
  narrate "「……健康なくせに、そんなところでサボってるの？」";
  await advance;
  narrate "久しぶりに学校に来たという、難病を抱えたクラスメイト。";
  await advance;
  narrate "ミオだった。";
  await advance;
  narrate "「うるせえな。お前には関係ないだろ」";
  await advance;
  narrate "「……贅沢な悩み。いらないなら、その身体、私に頂戴」";
  await advance;
  narrate "「人の身体を勝手に欲しがるな」";
  await advance;
  narrate "「いらないんでしょ」";
  await advance;
  narrate "ミオは俺の返事も待たず、窓際の椅子に腰を下ろした。";
  await advance;
  narrate "膝の上で、一冊のノートを開く。";
  await advance;
  narrate "横から、びっしりと書き込まれた文字が見えた。";
  await advance;
  narrate "駅の名前。時刻。金額。";
  await advance;
  narrate "知らない地名ばかりだった。";
  await advance;
  narrate "「何だ、それ」";
  await advance;
  narrate "「別に」";
  await advance;
  narrate "「駅名ばっかじゃねえか」";
  await advance;
  narrate "「見ないで」";
  await advance;
  narrate "ミオはノートを閉じ、俺から隠すように胸へ抱え込んだ。";
  await advance;
  narrate "そのまま何度か咳き込む。";
  await advance;
  narrate "廊下から、保健室の先生が顔を覗かせた。";
  await advance;
  narrate "「迎え、来たみたいよ」";
  await advance;
  narrate "「……分かりました」";
  await advance;
  narrate "ミオはノートをベッドの上へ置き、ゆっくりと立ち上がる。";
  await advance;
  narrate "「じゃあ」";
  await advance;
  narrate "「……ああ」";
  await advance;
  narrate "保健室のドアが閉まった。";
  await advance;
  narrate "少しして、ベッドの上に残されたノートへ目をやる。";
  await advance;
  narrate "「忘れてんじゃねえか」";
  await advance;
  narrate "追いかける気にはなれなかった。";
  await advance;
  narrate "明日返せばいい。";
  await advance;
  narrate "ノートを拾い上げる。";
  await advance;
  narrate "表紙には、何も書かれていない。";
  await advance;
  narrate "最初のページを開いた。";
  await advance;
  narrate "九月二十一日、午前六時。横浜駅。";
  await advance;
  narrate "その下には、列車の時刻と乗り換える駅が、細かく並んでいた。";
  await advance;
  narrate "ページを捲っても、また駅名。";
  await advance;
  narrate "西へ、西へ。";
  await advance;
  narrate "最後の行には、海、とだけ書かれていた。";
  await advance;
  narrate "俺はノートを閉じ、自分の鞄の底へ押し込んだ。";
  await advance;
  narrate "...";
  await advance;
  narrate "珍しく少し早起きして、学校に向かった日。";
  await advance;
  narrate "ちゃちゃっとアイツを探してあのノートを返したい。";
  await advance;
  narrate "後回しにするにしても、ちょっと邪魔だしな。";
  await advance;
  narrate "学校では、ほんの数人が塾のワークとにらめっこをしているぐらい。";
  await advance;
  narrate "こんな時間だし、よほどの気狂いじゃないと居ないだろうし、実際そうだった。";
  await advance;
  narrate "虱潰しに教室を巡る。";
  await advance;
  narrate "顔しか覚えて居ないのだが、その状態でまた見つけるってのは中々日が暮れそう。";
  await advance;
  narrate "大して見つけなくてもいい気がする、なんかさ、大事なもんだったら取りに来るだろ。";
  await advance;
  narrate "なんなら普通は大事なものだったら忘れていかない。";
  await advance;
  chapter "canonical_chapter_00" progress 100;
  clear dialogue;
  jump chapter_select_ja;
}

// Source: 01_start.md
scene novel_chapter_01 {
  locale "ja-JP";
  persistent flag "canonical_chapter_01_seen" = true;
  unlock chapter "canonical_chapter_01" progress 1;
  screen dialogue;
  background asset("#284b59") with fade(260ms);
  narrate "9月21日　横浜駅 6:00";
  await advance;
  narrate "早朝の駅には、特有の冷たい空気が沈殿している。";
  await advance;
  narrate "シャッターの閉まった売店。酔っ払いが残していった酒の匂い。";
  await advance;
  narrate "改札の電子音だけが、がらんとしたコンコースに響いていた。";
  await advance;
  narrate "「寒い...」";
  await advance;
  narrate "「お前、そんな薄手で家を出てきて何したいんだ」";
  await advance;
  narrate "「...別に、これがおしゃれだから...余計なお世話」";
  await advance;
  narrate "ミオはそう言って、スカートの裾を掴む。";
  await advance;
  narrate "震えているようにも見えた。秋の朝特有の肌寒さのせいなのか、それとも恐怖のせいなのかはわからない。";
  await advance;
  narrate "「おしゃれとか知らないし、温かいのでも着て来ればいいのに」";
  await advance;
  narrate "「別にいいじゃない......おしゃれしたって...」";
  await advance;
  narrate "遠くで、レールが微かな鉄鳴きを始める。";
  await advance;
  narrate "足元のコンクリートが低い振動を伝え、やがて冷たい風を引き連れて列車がやってきた。";
  await advance;
  narrate "プシューッと、重たい音を立ててドアが開く。";
  await advance;
  narrate "降りてくる少しばかりの人を避け、乗り込む。";
  await advance;
  narrate "「家に帰りたい...」";
  await advance;
  narrate "「...一体何を言ってるんだ」";
  await advance;
  narrate "俺は「はぁ」とため息をつき、ボックス席に腰を下ろす。";
  await advance;
  narrate "発車ベルが鳴り響き、それに合せてドアが閉まる。";
  await advance;
  narrate "ガクンと鈍い衝撃があり、列車がゆっくりと滑り出す。";
  await advance;
  narrate "ホームの景色が後ろへ後ろへと流れていく。もう、後戻りなどできない。";
  await advance;
  narrate "ふと、カバンの中を探る。";
  await advance;
  narrate "鞄の中には、歯ブラシとか、家の鍵とか入ってたけれど、底には、親父の部屋から抜き取ってきた10万円が入った封筒があった。";
  await advance;
  narrate "こんな大金、今まで見たこともなかった。";
  await advance;
  narrate "たった10枚の諭吉。";
  await advance;
  narrate "それが俺の15年の人生を売り払った対価だと思うと、ひどく薄っぺらくて笑えた。";
  await advance;
  narrate "「ミオ、薬は持ってきたのか」";
  await advance;
  narrate "「......うん。何日分か」";
  await advance;
  narrate "それだけ聞いて、俺は窓の外に目を戻した。 ";
  await advance;
  narrate "会話は長く続かず……車窓だけが楽しみのこの電車。";
  await advance;
  narrate "早朝だからか、混んでも居ないし。";
  await advance;
  narrate "只、窓から射し込む朝日が眩しいだけだった。";
  await advance;
  narrate "電車は辻堂に停車し、数人を吐き出して、また走り出す。";
  await advance;
  narrate "ふと、気になったことを聞いてみる。";
  await advance;
  narrate "「お前って、医者に食事制限とかされてんの？」";
  await advance;
  narrate "「そりゃあされてるよ。病人だしね」";
  await advance;
  narrate "さらっと言った。まるで天気の話みたいに。";
  await advance;
  narrate "「食事前にこの薬飲めとか、刺激物は控えろとか。まあ色々」";
  await advance;
  narrate "「……ふーん」";
  await advance;
  narrate "それ以上は聞けなかった。";
  await advance;
  narrate "聞いたところで、俺にできることなんて何もないしな。";
  await advance;
  narrate "列車はどんどん進み、小田原に着いた。";
  await advance;
  narrate "ここらへんから、人がどっと増える。";
  await advance;
  narrate "「……座れてて良かったね」";
  await advance;
  narrate "立っている客の群れを見ながら、ミオがぽつりと呟いた。";
  await advance;
  narrate "「確かにな...」";
  await advance;
  narrate "段々と車内が蒸し暑くなって、雲でも出来るぐらいの湿気になった頃。";
  await advance;
  narrate "ふと、制服のポケットにあるJ-PHONEの重みを思い出した。";
  await advance;
  narrate "ミオにカメラを向ける。";
  await advance;
  narrate "「……やめてよ」";
  await advance;
  narrate "顔を手で隠された。";
  await advance;
  narrate "「なんでだよ」";
  await advance;
  narrate "「写真、嫌い」";
  await advance;
  narrate "「……そうかよ」";
  await advance;
  narrate "嫌がるなら、しょうがない。";
  await advance;
  narrate "代わりに窓の外にレンズを向け、シャッターを切った。";
  await advance;
  narrate "チープな電子音が車内に響く。";
  await advance;
  narrate "「……見せて」";
  await advance;
  narrate "俺とミオで、小さな液晶画面を覗き込む。";
  await advance;
  narrate "画質は粗い。けれど、青い海だけはちゃんと写っていた。";
  await advance;
  narrate "「……綺麗じゃん」";
  await advance;
  narrate "「まあな」";
  await advance;
  narrate "電車は神奈川県を抜け、熱海へと到着した。";
  await advance;
  narrate "ここからはJR東海だ。";
  await advance;
  narrate "長い丹那トンネルを抜け、ついにこの電車の終点・沼津に着いた。";
  await advance;
  narrate "俺たちは電車を降り、ホームのキヨスクへと向かう。";
  await advance;
  narrate "狭い店先のラックには、分厚い週刊少年ジャンプや、『小泉内閣』の文字が躍るスポーツ新聞が並べられている。";
  await advance;
  narrate "「ミオ、なんか食うか」";
  await advance;
  narrate "「......水と、弁当」";
  await advance;
  narrate "水と、鯛めしを二つ手に取る。";
  await advance;
  narrate "「鯛、食えるよな？」";
  await advance;
  narrate "「......うん」";
  await advance;
  narrate "レジで一万円を出した。釣りを受け取る。";
  await advance;
  narrate "鯛めしの包みを開ける。";
  await advance;
  narrate "ほぐされた鯛の身と、冷えた飯。彩りの野菜と、わさび漬け。";
  await advance;
  narrate "駅弁ってのは、こんなもんだ。冷えてるし、量も少ない。";
  await advance;
  narrate "けれど、今の俺にはやけに美味かった。";
  await advance;
  narrate "ミオの方を見ると、小さなスプーンでちまちまと口に運んでいる。";
  await advance;
  narrate "「……ん。鯛、美味しいね」";
  await advance;
  narrate "「これでご飯が温かかったらなあ……」";
  await advance;
  narrate "「弁当だからな。しょうがねえだろ」";
  await advance;
  narrate "「病院のご飯って、全部ぬるいの。おかずも、味噌汁も。熱いものは出してもらえないんだよ」";
  await advance;
  narrate "さらっと言った。";
  await advance;
  narrate "俺は箸を止めて、それから何も言えずに、また鯛を口に運んだ。";
  await advance;
  narrate "……";
  await advance;
  narrate "静岡で乗り換え。浜松で乗り換え。";
  await advance;
  narrate "ただただ、レールの上を西へ向かって滑っていく。";
  await advance;
  narrate "最初は少しだけあった高揚感も、硬いボックス席の背もたれに座り続けているうちに、ケツの痛みと退屈に変わっていった。";
  await advance;
  narrate "掛川に着いた時、ドアが開いて秋の乾いた風が吹き込んだ。";
  await advance;
  narrate "その直後、轟音と共に白い新幹線が俺たちの横を通り抜けていった。";
  await advance;
  narrate "鼓膜が破れそうなほどの風切り音。";
  await advance;
  narrate "車体がかすかに揺れ、新幹線はあっという間に見えなくなった。";
  await advance;
  narrate "「……はえーな」";
  await advance;
  narrate "「……そうだね」";
  await advance;
  narrate "新幹線に乗れば、数時間で着く距離。";
  await advance;
  narrate "それを俺たちは、各駅停車でちまちまと進んでいる。";
  await advance;
  narrate "まあ、急ぐ旅でもない。どうせ行くあてなんてないんだから。";
  await advance;
  narrate "単調なレールのジョイント音が、等間隔で車内に響く。";
  await advance;
  narrate "ガタン、ゴトン。ガタン、ゴトン。";
  await advance;
  narrate "ふと隣を見ると、ミオがカバンからMDウォーカーを取り出し、イヤホンを耳に突っ込んでいた。";
  await advance;
  narrate "小さな液晶リモコンを操作して、目を閉じる。";
  await advance;
  narrate "「お前、何聴いてんの？」";
  await advance;
  narrate "「……内緒」";
  await advance;
  narrate "「なんだよ、減るもんじゃねえだろ」";
  await advance;
  narrate "「......教えない」";
  await advance;
  narrate "ミオはイヤホンをしたまま、コトンと窓枠に頭をもたせかけた。";
  await advance;
  narrate "「おい、寝るのか？」";
  await advance;
  narrate "「……ちょっとだけ」";
  await advance;
  narrate "ミオは目をこすり、小さくあくびをした。";
  await advance;
  narrate "さっき食った弁当と、単調な揺れが眠気を誘ったんだろう。";
  await advance;
  narrate "「着いたら、起こして……」";
  await advance;
  narrate "「ああ」";
  await advance;
  narrate "ミオは二つの席を贅沢に使い、丸くなるようにして目を閉じた。";
  await advance;
  narrate "すぐに、規則正しい小さな寝息が聞こえ始めた。";
  await advance;
  narrate "イヤホンからは、かすかにシャカシャカという音漏れが聞こえる。";
  await advance;
  narrate "どんな曲かはわからない。ただ、その小さな音が、やけに車内に響いて聞こえた。";
  await advance;
  narrate "話し相手がいなくなった俺は、無意味に流れる窓の景色を眺めた。";
  await advance;
  narrate "田んぼ。工場。知らない街の看板。";
  await advance;
  narrate "時折、駅に停まるたびに人が乗ってきては、降りていく。";
  await advance;
  narrate "ミオはピクリとも動かなかった。";
  await advance;
  narrate "死んでるんじゃないかと思って、何度か肩のあたりが上下しているのを確かめた。";
  await advance;
  narrate "ちゃんと息をしてる。";
  await advance;
  narrate "俺もいつの間にか、うとうとと船を漕いでいた。";
  await advance;
  narrate "……";
  await advance;
  narrate "「ねえ。起きてよ」";
  await advance;
  narrate "肩を揺すられて、ハッと目を覚ます。";
  await advance;
  narrate "「……ん？」";
  await advance;
  narrate "「もう着くよ」";
  await advance;
  narrate "ミオは呆れた顔でこちらを見下ろしていた。";
  await advance;
  narrate "「……悪い。寝てた」";
  await advance;
  narrate "「置いていくところだったよ」";
  await advance;
  narrate "「お前が先に寝てただろ」";
  await advance;
  narrate "「私は病弱だからいいの」";
  await advance;
  narrate "無茶苦茶な理屈だ。";
  await advance;
  narrate "俺たちは急いで荷物をまとめ、列車を降りた。";
  await advance;
  narrate "……";
  await advance;
  narrate "愛知県に入ってからも、無機質な移動は続いた。";
  await advance;
  narrate "豊橋で特別快速に乗り換え、名古屋という馬鹿でかいターミナルを通過する。";
  await advance;
  narrate "窓の外の景色はビル群に変わり、そしてまたすぐに田園風景に戻っていった。";
  await advance;
  narrate "西へ向かうにつれて、窓の外の景色が茜色に染まり始めた。";
  await advance;
  narrate "太陽が沈んでいく。俺たちの最初の一日目が、終わろうとしていた。";
  await advance;
  narrate "列車の中は混み合っていて、俺たちは座ることができたが、周りには立っている客がたくさんいた。";
  await advance;
  narrate "スーツ姿のサラリーマン。部活帰りの高校生。";
  await advance;
  narrate "誰も俺たちのことなんか気に留めない。";
  await advance;
  narrate "ミオはまた、俺の肩にもたれかかって眠っていた。";
  await advance;
  narrate "その頭の重さが、妙にリアルだった。";
  await advance;
  narrate "そして、外がすっかり暗くなった頃、列車は大垣に到着する。";
  await advance;
  narrate "ここで乗り換えないと、関西方面には行けない。";
  await advance;
  narrate "「起きろ、ミオ。着いたぞ」";
  await advance;
  narrate "「……んん……」";
  await advance;
  narrate "ミオは目をこすりながら、ふらふらと立ち上がった。";
  await advance;
  narrate "ドアが開き、客が一斉にホームへと吐き出される。";
  await advance;
  narrate "みんな、次の列車に乗るために跨線橋へと歩き出していた。";
  await advance;
  narrate "「ほら、早く降りるぞ」";
  await advance;
  narrate "「ま、まって……」";
  await advance;
  narrate "目をこすってるミオの手を引き、人ごみを掻き分けて歩く。";
  await advance;
  narrate "階段を上がり、跨線橋を渡る。";
  await advance;
  narrate "そしてまたホームへ降り、すでに発車しそうな電車に乗り込む。";
  await advance;
  narrate "なんとか、席を確保し、ミオを座らせる。";
  await advance;
  narrate "相席になっちゃうけど、仕方ない。";
  await advance;
  narrate "俺もその隣に倒れ込んだ。";
  await advance;
  narrate "「混んでる...」";
  await advance;
  narrate "「そりゃそうさ」";
  await advance;
  narrate "発車ベルが鳴り、ドアが閉まる。";
  await advance;
  narrate "列車は、真っ暗な関ヶ原を越えて米原へと向かい始めた。";
  await advance;
  narrate "……";
  await advance;
  narrate "米原。新快速に乗り換え。";
  await advance;
  narrate "ここからはJR西日本だ。";
  await advance;
  narrate "列車は今までとは比べ物にならないスピードで、京都、高槻、新大阪、大阪を素通りしていく。";
  await advance;
  narrate "窓の外の景色が、どんどん見知らぬものに変わっていく。";
  await advance;
  narrate "もう、誰も俺たちのことなんか知らない。";
  await advance;
  narrate "列車が三ノ宮に滑り込もうとした時だった。";
  await advance;
  narrate "「……疲れたよ」";
  await advance;
  narrate "ミオが、ぽつりと呟いた。";
  await advance;
  narrate "「今日はここで休まない？」";
  await advance;
  narrate "俺は少し考えた。";
  await advance;
  narrate "一日中電車に揺られたせいか、ミオの顔色は朝よりもさらに白かった。";
  await advance;
  narrate "「……そうするか」";
  await advance;
  narrate "ドアが閉まる直前に飛び降り、改札を抜ける。";
  await advance;
  narrate "……";
  await advance;
  narrate "普通のホテルには泊まれない。";
  await advance;
  narrate "身分証を出せば終わりだ。";
  await advance;
  narrate "俺たちが行ける場所は、一つしかなかった。";
  await advance;
  narrate "けばけばしいネオンが並ぶ通りを歩く。";
  await advance;
  narrate "「……ねえ、ここって」";
  await advance;
  narrate "「機械で鍵が出る。名前も聞かれない。金さえあればどうにかなる」";
  await advance;
  narrate "「……」";
  await advance;
  narrate "パネルに並ぶ、無駄に豪華な部屋の写真。";
  await advance;
  narrate "適当なボタンを押し、財布から一万円を入れる。";
  await advance;
  narrate "カラン、と無機質な音を立てて、鍵が吐き出された。";
  await advance;
  narrate "薄暗い廊下を渡り、部屋のドアを開ける。";
  await advance;
  narrate "無駄に広い。無駄にけばけばしい壁紙。";
  await advance;
  narrate "ミオはベッドを見つけた途端、電池が切れたみたいに倒れ込んだ。";
  await advance;
  narrate "靴を脱ぐことすら忘れて。";
  await advance;
  narrate "……";
  await advance;
