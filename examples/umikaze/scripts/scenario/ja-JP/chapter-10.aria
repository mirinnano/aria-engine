scene novel_chapter_10_story {
  screen dialogue;
  background asset("#4e5c66") with fade(360ms);
  wait 180ms;
  clear dialogue;
  background asset("#506473") with fade(360ms);
  wait 280ms;
  narrate "硬いベンチで目を覚ますと、待合室に朝の光が差し込んでいた。";
  await advance;
  narrate "体中が痛い。隣のミオは、俺の上着を抱えたまま、まだ眠っている。";
  await advance;
  narrate "いつの間にか、シャッターは開いていた。";
  await advance;
  narrate "ホームには、人が数人ぐらい。";
  await advance;
  narrate "まだ眠ってるミオを叩き起こして、始発列車に乗った。";
  await advance;
  narrate "行き先は見なかった。";
  await advance;
  clear dialogue;
  wait 720ms;
  clear dialogue;
  background asset("#766e61") with fade(360ms);
  wait 280ms;
  narrate "乗り換えの途中、昼ごはんを食べる。";
  await advance;
  narrate "ホームの端にある立ち食いの店に入って、";
  await advance;
  narrate "湯気を上げるかけうどんを一つ頼み、割り箸を割る。";
  await advance;
  narrate "先にミオに食べさせ、残りを俺がもらうことに。";
  await advance;
  narrate "ミオは三口ほど啜って、箸を置いた。";
  await advance;
  narrate "「......もういい。残り、食べていいよ」";
  await advance;
  narrate "俺はミオの丼を引き寄せ、黙って食った。";
  await advance;
  narrate "少しふやけた麺は、あまり味がしなかった。";
  await advance;
  narrate "それでも、食えるからまだいいけどさ。";
  await advance;
  clear dialogue;
  wait 720ms;
  narrate "また列車に乗った。";
  await advance;
  clear dialogue;
  background asset("#244e5a") with fade(360ms);
  wait 280ms;
  narrate "山を抜けるたび、低い町が見えた。";
  await advance;
  narrate "夕方には、海沿いの小さな駅が続いた。";
  await advance;
  narrate "どこも、降りる理由がなかった。";
  await advance;
  narrate "窓の外は、ずっと同じ色をしていた。";
  await advance;
  narrate "鉛色の空と、灰色の海。";
  await advance;
  narrate "ミオは鞄から薬のシートを出した。";
  await advance;
  narrate "残りを指で数えるように触って、一錠だけ押し出す。";
  await advance;
  narrate "「水、あるか」";
  await advance;
  narrate "「あるよ」";
  await advance;
  narrate "ペットボトルの底に残った水で、薬を飲んだ。";
  await advance;
  clear dialogue;
  wait 900ms;
  narrate "いつの間にか、ミオは眠っていた。";
  await advance;
  narrate "俺もいつの間にか、眠っていた。";
  await advance;
  narrate "起きたら、強い喉の渇きを覚えた。";
  await advance;
  narrate "列車はトンネルの中にいた。";
  await advance;
  narrate "特に何も行き先を見ずに乗ってるから、どこで止まって、どこが終点なのかも知らない。";
  await advance;
  narrate "空になったペットボトルを振った。";
  await advance;
  narrate "音はしなかった。";
  await advance;
  clear dialogue;
  wait 900ms;
  narrate "一体、俺って何をしているんだろ。";
  await advance;
  narrate "そんで、何したいんだろうか。";
  await advance;
  narrate "家の机も、学校の机も、まだあの場所にある。";
  await advance;
  narrate "戻れば、また同じ朝が来る。";
  await advance;
  narrate "俺は、行きたい場所があったわけじゃない。";
  await advance;
  narrate "ただ、同じ朝を終わらせたかった。";
  await advance;
  clear dialogue;
  screen statement;
  background asset("#6d706f") with fade(260ms);
  narrate "この無意味な生に、ピリオドを打ちたくて。";
  wait 2400ms;
  background asset("#244e5a") with fade(360ms);
  screen dialogue;
  clear dialogue;
  wait 180ms;
  narrate "そう思ったところで、停車を知らせるベルが鳴った。";
  await advance;
  narrate "ミオは眠ったまま、俺の上着の袖を握っていた。";
  await advance;
  narrate "俺は立ち上がらなかった。";
  await advance;
  clear dialogue;
  wait 1800ms;
  narrate "……";
  await advance;
  clear dialogue;
  effect tint "#05070b" amount 64 over 520ms;
  wait 520ms;
  chapter "canonical_chapter_10" progress 100;
  clear dialogue;
  background asset("#05070b") with fade(480ms);
  wait 480ms;
  jump chapter_select_ja;
}
